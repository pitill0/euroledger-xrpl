    {
      "parameters": {
        "jsCode": "const payload = $json.body ?? $json;\nconst groupedAlerts = Array.isArray(payload.alerts) && payload.alerts.length ? payload.alerts : [{}];\n\nreturn groupedAlerts.map((alert) => {\n  const labels = { ...(payload.commonLabels ?? {}), ...(alert.labels ?? {}) };\n  const annotations = { ...(payload.commonAnnotations ?? {}), ...(alert.annotations ?? {}) };\n\n  return {\n    json: {\n      receiver: payload.receiver ?? null,\n      status: alert.status ?? payload.status ?? 'unknown',\n      alertname: labels.alertname ?? 'unknown',\n      severity: labels.severity ?? 'unknown',\n      component: labels.component ?? 'unknown',\n      summary: annotations.summary ?? '',\n      description: annotations.description ?? '',\n      startsAt: alert.startsAt ?? null,\n      endsAt: alert.endsAt ?? null,\n      generatorURL: alert.generatorURL ?? null,\n      fingerprint: alert.fingerprint ?? null,\n      groupKey: payload.groupKey ?? null,\n      groupLabels: payload.groupLabels ?? {},\n      labels,\n      annotations,\n      originalPayload: payload,\n    },\n  };\n});"
      },
      "id": "f625a3c8-97a2-4240-8bd6-46411c624cb4",
