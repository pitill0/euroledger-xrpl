    {
      "parameters": {
        "jsCode": "const statusIcons = {\n  firing: '🚨',\n  resolved: '✅',\n  unknown: '❓',\n};\nconst severityIcons = {\n  critical: '🔴',\n  warning: '🟠',\n  unknown: '⚪',\n};\n\nconst statusIcon = statusIcons[$json.status] ?? statusIcons.unknown;\nconst severityIcon = severityIcons[$json.severity] ?? severityIcons.unknown;\nconst headline = $json.status === 'resolved'\n  ? 'EuroLedger alert resolved'\n  : 'EuroLedger alert';\n\nconst lines = [\n  `${statusIcon} ${severityIcon} ${headline}`,\n  '',\n  `Alert: ${$json.alertname}`,\n  `Status: ${$json.status}`,\n  `Severity: ${$json.severity}`,\n  `Component: ${$json.component}`,\n];\n\nif ($json.summary) lines.push(`Summary: ${$json.summary}`);\nif ($json.description) lines.push(`Description: ${$json.description}`);\nif ($json.startsAt) lines.push(`Started: ${$json.startsAt}`);\nif ($json.status === 'resolved' && $json.endsAt) lines.push(`Resolved: ${$json.endsAt}`);\nif ($json.generatorURL) lines.push(`Source: ${$json.generatorURL}`);\n\nreturn [{ json: { ...$json, telegramMessage: lines.join('\\n') } }];"
      },
      "id": "6f786b38-7021-413f-b33d-4962a370830c",
