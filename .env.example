# EuroLedger XRPL local development environment
#
# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# Never commit .env. Replace all production secrets before deploying.

# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------

APP_ENV=local
APP_NAME=EuroLedger XRPL

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Used to hash merchant API keys at rest.
# Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
MERCHANT_API_KEY_PEPPER=replace-with-a-random-secret-at-least-32-characters-long

# Optional development HTML dashboard token.
# Leave empty to disable /dashboard views.
DASHBOARD_TOKEN=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

POSTGRES_DB=euroledger
POSTGRES_USER=euroledger
POSTGRES_PASSWORD=euroledger
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# XRPL
# -----------------------------------------------------------------------------

XRPL_NETWORK=testnet
XRPL_JSON_RPC_URL=https://s.altnet.rippletest.net:51234/
XRPL_WEBSOCKET_URL=wss://s.altnet.rippletest.net:51233

# Read-only payment validation settings.
XRPL_MERCHANT_ADDRESS=
XRPL_ISSUER_ADDRESS=
XRPL_CURRENCY_CODE=EUR

# Demo issued currency labels.
DEMO_CURRENCY_CODE=EUR
DEMO_CURRENCY_DISPLAY=EUR.demo

# Demo issuer/customer/merchant seeds.
# Never use production secrets here.
XRPL_DEMO_ISSUER_SEED=
XRPL_DEMO_MERCHANT_SEED=
XRPL_DEMO_CUSTOMER_SEED=

# -----------------------------------------------------------------------------
# XRPL worker
# -----------------------------------------------------------------------------

XRPL_WORKER_LIMIT=20
XRPL_WORKER_POLL_INTERVAL=30
XRPL_WORKER_STALE_AFTER_SECONDS=120

# -----------------------------------------------------------------------------
# Payment intent expiration worker
# -----------------------------------------------------------------------------

PAYMENT_INTENT_EXPIRER_LIMIT=100
PAYMENT_INTENT_EXPIRER_POLL_INTERVAL=60
PAYMENT_INTENT_EXPIRER_STALE_AFTER_SECONDS=180

# -----------------------------------------------------------------------------
# Merchant webhook delivery worker
# -----------------------------------------------------------------------------

WEBHOOK_WORKER_LIMIT=100
WEBHOOK_WORKER_TIMEOUT=10
WEBHOOK_WORKER_MAX_ATTEMPTS=5
WEBHOOK_WORKER_POLL_INTERVAL=30
WEBHOOK_DELIVERY_WORKER_STALE_AFTER_SECONDS=180

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

ALERTMANAGER_PORT=9093

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Europe/Madrid
