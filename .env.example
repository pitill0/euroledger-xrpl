# Project
APP_ENV=local
APP_NAME=EuroLedger XRPL

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
POSTGRES_DB=euroledger
POSTGRES_USER=euroledger
POSTGRES_PASSWORD=euroledger
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# XRPL
XRPL_NETWORK=testnet
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
XRPL_WEBSOCKET_URL=wss://s.altnet.rippletest.net:51233

# Demo issuer/customer/merchant seeds
# Never use production secrets here.
XRPL_DEMO_ISSUER_SEED=
XRPL_DEMO_MERCHANT_SEED=
XRPL_DEMO_CUSTOMER_SEED=

# Demo issued currency
DEMO_CURRENCY_CODE=EUR
DEMO_CURRENCY_DISPLAY=EUR.demo
